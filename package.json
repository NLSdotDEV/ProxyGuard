{
  "name": "ProxyGuard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "imports": {
    "#aegis/http": {
      "types": "./src/core/packages/http/index.ts",
      "default": "./build/core/packages/http/index.js"
    },
    "#aegis/database": {
      "types": "./src/core/packages/database/index.ts",
      "default": "./build/core/packages/database/index.js"
    },
    "#aegis/queues": {
      "types": "./src/core/packages/queues/index.ts",
      "default": "./build/core/packages/queues/index.js"
    },
    "#aegis/*": {
      "types": "./src/core/packages/*",
      "default": "./build/core/packages/*"
    },
    "#entity": {
      "types": "./src/database/entities/index.ts",
      "default": "./build/database/entities/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node build/main.js",
    "dev": "nodemon --watch src -e ts --exec \"tsx src/main.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "migration:create": "npx mikro-orm migration:create",
    "migration:up": "npx mikro-orm migration:up"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^26.6.5",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.3",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.48.0"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/env": "^7.0.1",
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/type-provider-typebox": "^6.3.0",
    "@mikro-orm/cli": "^7.2.5",
    "@mikro-orm/core": "^7.2.5",
    "@mikro-orm/decorators": "^7.2.5",
    "@mikro-orm/entity-generator": "^7.2.5",
    "@mikro-orm/migrations": "^7.2.5",
    "@mikro-orm/mongodb": "^7.2.5",
    "@mikro-orm/postgresql": "^7.2.5",
    "@mikro-orm/reflection": "^7.2.5",
    "@mikro-orm/seeder": "^7.2.5",
    "@mikro-orm/sqlite": "^7.2.5",
    "argon2": "^0.45.1",
    "axios": "^1.20.0",
    "bullmq": "^6.3.17",
    "dotenv": "^18.0.8",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "typebox": "^1.4.2"
  }
}
