# ==============================================================================
# ProxyGuard Production Environment Configuration
# ==============================================================================

# Application environment
ENV=production
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Redis configuration (internal container networking)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ProxyScrape upstream API base URL
PROXY_SCRAPE_BASE_API_URL=https://api.proxyscrape.com/v4

# Optional: Extra internal or VPN IPs to permit through Caddy access control
# (e.g. "10.0.0.50 192.168.1.100")
ALLOWED_INTERNAL_IPS=127.0.0.1

# Host port mappings (bound to loopback 127.0.0.1 only)
APP_PORT=3000
REDIS_PORT=6379
